# ── Content (synced via S3/iCloud, not git) ──
# NOTE: all patterns below are root-anchored (leading `/`). Without the
# leading slash, git matches the name at ANY depth in the repo — e.g. an
# unanchored `Work/` would also hide `.claude/commands/work/` and
# `system/modules/work/`, silently untracking unrelated workflow files.
# Bug found 2026-07: this cost us 7 untracked command files (work + learning).
/Archive/
/Attachments/
/Essays/
/Excalidraw/
/system-design-primer/
/Kanban/
/Instapaper Notes/*
!/Instapaper Notes/Instapaper Index.md
/Matter/*
!/Matter/Matter Index.md
/Thoughts/
# Learning/ is vault content (books, patterns, logs, sandboxes) — not tracked.
# Exceptions below are workflow tooling only (CLAUDE.md, dashboards, init scripts).
/Learning/*
!/Learning/Books/
/Learning/Books/*
!/Learning/Books/CLAUDE.md
!/Learning/Books/.bookrc.example
!/Learning/Books/book_init.py
!/Learning/Books/extract_fulltext.py
!/Learning/Books/test_extract_fulltext.py
!/Learning/Books/Books Index.md
!/Learning/Practice/
/Learning/Practice/*
!/Learning/Practice/Algorithm/
/Learning/Practice/Algorithm/*
!/Learning/Practice/Algorithm/CLAUDE.md
!/Learning/Practice/Frontend/
/Learning/Practice/Frontend/*
!/Learning/Practice/Frontend/CLAUDE.md
!/Learning/Practice/Frontend/00_index.md
!/Learning/Practice/Grammar/
/Learning/Practice/Grammar/*
!/Learning/Practice/Grammar/CLAUDE.md
!/Learning/Practice/Grammar/00_index.md
!/Learning/Practice/System-Design/
/Learning/Practice/System-Design/*
!/Learning/Practice/System-Design/CLAUDE.md
!/Learning/Practice/System-Design/00_index.md
/WeRead/
/ibooks-highlights/
/Work/
/Inbox/
/Zettelkasten/*
!/Zettelkasten/Zettelkasten Index.md
/Profile/
/Note/
/Feeds/

# ── Pipeline runtime state ──
scripts/ai-digest/history.json
scripts/github-trending/history.json
scripts/engineering-blogs/history.json
.pr-review-state/

# ── Plugin runtime state ──
.claudian/
.omc/

# ── Claude Code config ──
.claude/*
!.claude/commands/
# no trailing slash: .claude/skills is a symlink (to .agents/skills), not a
# real directory, and trailing-slash patterns only un-ignore real directories
!.claude/skills
!.claude/CLAUDE.md
.bookrc

# ── Obsidian internals ──
.obsidian/

# ── System ──
.DS_Store
__pycache__/
*.pyc
*.log
.venv/
.env
